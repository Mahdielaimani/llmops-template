# Copy to .env (gitignored). Every value has a safe local default; only set what you change.
# Nesting: LLMOPS_<SECTION>__<FIELD>

# --- app ---
LLMOPS_APP__ENV=local            # local | dev | staging | prod | test
LLMOPS_APP__LOG_LEVEL=INFO
LLMOPS_APP__LOG_FORMAT=json      # json | console (console = human-friendly for `poe dev`)

# --- server ---
LLMOPS_SERVER__PORT=8080

# --- llm provider (MODE C mock default; MODE B vllm/ollama; MODE A openai/anthropic) ---
LLMOPS_LLM__PROVIDER=mock        # mock | vllm | ollama | openai | anthropic
LLMOPS_LLM__MODEL=mock-1
# LLMOPS_LLM__BASE_URL=http://vllm:8000/v1
# LLMOPS_LLM__API_KEY=            # never commit a real value
LLMOPS_LLM__TIMEOUT_S=30
LLMOPS_LLM__MAX_TOKENS=512

# --- state stores (compose service names = service discovery) ---
LLMOPS_POSTGRES__HOST=postgres
LLMOPS_POSTGRES__PASSWORD=llmops
POSTGRES_PASSWORD=llmops         # consumed by the postgres container itself
LLMOPS_REDIS__URL=redis://redis:6379/0
LLMOPS_QDRANT__URL=http://qdrant:6333

# --- images ---
IMAGE_TAG=dev
